# 复用宿主机演示中间件时使用（docker-compose.dev.yml）。复制为 .env.dev 后按本机实际账号修改。
HTTP_PORT=8090

MYSQL_PORT=3306
MYSQL_DATABASE=payops
MYSQL_USER=root
MYSQL_PASSWORD=change-me

REDIS_CONNECTION=host.docker.internal:6379

RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# 与本机 dotnet run（appsettings.Development.json）保持一致，才能解密同一个库里已保存的通道凭证
PAYOPS_MASTER_KEY=dev-only-master-key-change-me-in-production
PAYOPS_JWT_KEY=dev-only-jwt-key-change-me-in-production

NPM_REGISTRY=https://registry.npmjs.org
