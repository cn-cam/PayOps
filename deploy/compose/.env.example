# 复制为 .env 后修改。所有密钥务必替换为随机值。

# 对外访问地址：用于拼接给上游（微信/支付宝/各商店）的回调地址，生产必须是公网 HTTPS 域名
PUBLIC_BASE_URL=http://localhost:8090
HTTP_PORT=8090
RABBITMQ_MGMT_PORT=15673

# 中间件口令
MYSQL_ROOT_PASSWORD=change-me-mysql
REDIS_PASSWORD=change-me-redis
RABBITMQ_USER=payops
RABBITMQ_PASSWORD=change-me-rabbit

# 通道凭证/应用密钥的落库加密主密钥：所有副本必须一致；丢失后已保存的凭证无法解密，请妥善备份
PAYOPS_MASTER_KEY=change-me-to-a-long-random-string
# 管理后台登录令牌签名密钥：所有副本必须一致
PAYOPS_JWT_KEY=change-me-to-another-long-random-string
# 首次启动创建 admin 账号的初始密码（登录后请立即修改）
PAYOPS_ADMIN_PASSWORD=Admin@123456

# 演示端点（模拟业务方通知接收端），生产保持 false
ENABLE_DEMO_ENDPOINTS=false

# 构建镜像时使用的 npm 源，国内可改为 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org
