# 复制为 secret.env 并填写。每行 KEY=VALUE，不要加引号。
# MySQL：主从/MGR 的写入口（VIP 或 Proxy）
PayOps__Database__ConnectionString=Server=mysql.internal;Port=3306;Database=payops;User ID=payops;Password=CHANGE_ME;MaximumPoolSize=100;
# Redis：单机 / Sentinel（例：sentinel-0:26379,sentinel-1:26379,serviceName=mymaster,password=xxx）/ Cluster（列出多个节点）
PayOps__Redis__ConnectionString=redis.internal:6379,password=CHANGE_ME
# RabbitMQ：集群填多个节点，逗号分隔；队列默认使用仲裁队列（quorum）
PayOps__RabbitMq__Hosts=rabbit-0.internal:5672,rabbit-1.internal:5672,rabbit-2.internal:5672
PayOps__RabbitMq__UserName=payops
PayOps__RabbitMq__Password=CHANGE_ME
# 落库加密主密钥与后台令牌密钥：所有副本一致；主密钥丢失后通道凭证无法解密，务必离线备份
PayOps__Security__MasterKey=CHANGE_ME_LONG_RANDOM
PayOps__Security__JwtKey=CHANGE_ME_LONG_RANDOM
PayOps__Security__InitAdminPassword=CHANGE_ME
