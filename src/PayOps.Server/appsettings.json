{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff ",
        "UseUtcTimestamp": false
      }
    }
  },
  "AllowedHosts": "*",
  "PayOps": {
    "Roles": "All",
    "PublicBaseUrl": "http://localhost:5080",
    "TimeZoneOffsetHours": 8,
    "Database": {
      "ConnectionString": "",
      "AutoMigrate": true
    },
    "Redis": {
      "ConnectionString": "localhost:6379",
      "KeyPrefix": "payops:"
    },
    "RabbitMq": {
      "Hosts": "localhost:5672",
      "UserName": "guest",
      "Password": "guest",
      "VirtualHost": "/",
      "Prefix": "payops",
      "QueueType": "quorum",
      "NotifyPrefetch": 20,
      "CheckPrefetch": 10
    },
    "Security": {
      "MasterKey": "",
      "JwtKey": "",
      "JwtExpireMinutes": 480,
      "InitAdminPassword": "Admin@123456",
      "SignToleranceSeconds": 300
    },
    "Order": {
      "DefaultExpireSeconds": 1800,
      "MaxRouteAttempts": 3,
      "CheckIntervals": [ 30, 60, 120, 300, 600 ],
      "RefundCheckMaxCount": 30
    },
    "Notify": {
      "TimeoutSeconds": 10,
      "RetryIntervals": [ 15, 30, 60, 180, 600, 1800, 3600, 7200, 21600 ]
    },
    "Breaker": {
      "FailureThreshold": 5,
      "WindowSeconds": 60,
      "OpenSeconds": 30
    }
  }
}
